# Frontend Environment Variables
# API base URL for the backend server.
#
# Leave this EMPTY for local development. Every request in this app is written
# as an absolute path that already starts with /api and Vite proxies it to the
# backend, which keeps auth cookies first-party (required for persistent login).
#
# Only set this to a full origin when the built frontend is served from a
# different host than the backend:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
